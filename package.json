{
  "name": "amp-pi",
  "version": "0.1.0",
  "description": "A general, extensible pack of enhancements for the Pi agent harness: auto-skills, skill-loader, pinned-model, memory-lite, and post-update workflows.",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "pi"],
  "license": "MIT",
  "pi": {
    "extensions": ["./extensions"]
  },
  "bin": {
    "amp-pi-repair-herdr": "./scripts/repair-herdr-agent.ts",
    "amp-pi-update-from-ak": "./scripts/update-pi-from-ak.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "bun test",
    "repair-herdr": "bun run ./scripts/repair-herdr-agent.ts",
    "update-from-ak": "bun run ./scripts/update-pi-from-ak.ts",
    "ak-update": "bun run ./scripts/update-pi-from-ak.ts --update",
    "typecheck": "echo 'tsc not available offline; use bun test + bun build' && exit 0"
  }
}
